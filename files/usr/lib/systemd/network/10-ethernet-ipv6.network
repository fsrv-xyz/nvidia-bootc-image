# Host networking: stable EUI-64 IPv6 via SLAAC, plus IPv4 via DHCP.
#
# The IPv6 side still forms exactly one stable global address: the EUI-64 identifier
# derived from the interface MAC (deterministic, no privacy/temporary addresses).
# The link-local address is likewise EUI-64 based. IPv4 is obtained via DHCPv4.
[Match]
Type=ether

[Network]
# IPv4 via DHCP; IPv6 stays on SLAAC (RA) below.
DHCP=ipv4
LinkLocalAddressing=ipv6
IPv6AcceptRA=yes
# Deterministic, MAC-based interface identifier (EUI-64) for SLAAC and link-local.
IPv6Token=eui64
IPv6LinkLocalAddressGenerationMode=eui64
# No temporary/privacy addresses -> only the single stable EUI-64 address remains.
IPv6PrivacyExtensions=no

[IPv6AcceptRA]
# Use DNS servers advertised via RA (RDNSS).
UseDNS=yes
