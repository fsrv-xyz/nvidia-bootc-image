#!/usr/bin/env bash
# Validate CUDA inside a container via CDI (nvidia.com/gpu).
#
# Default (lightweight, fits on small test disks): CDI injects the NVIDIA driver
# including libcuda.so.1 into a small Fedora container; it checks nvidia-smi plus
# the CUDA driver API (cuInit/cuDeviceGetCount/cuDeviceGetName). The image is
# hosted on quay.io so it is reachable on IPv6-only hosts.
#
# CUDA_FULL=1: additionally run the classic nvcc deviceQuery in a CUDA devel image
# (needs ~4 GB of free space for the image pull).
set -euo pipefail

SMALL_IMAGE="${SMALL_IMAGE:-quay.io/fedora/fedora:42}"
FULL_IMAGE="${CUDA_IMAGE:-docker.io/nvidia/cuda:12.6.2-devel-ubi9}"
PODMAN=(podman run --rm --device nvidia.com/gpu=all --security-opt label=disable)

echo "== nvidia-smi inside a container (CDI) =="
"${PODMAN[@]}" "${SMALL_IMAGE}" nvidia-smi -L

echo "== CUDA driver API inside a container (libcuda via CDI) =="
"${PODMAN[@]}" "${SMALL_IMAGE}" python3 - <<'PY'
import ctypes, sys
cuda = ctypes.CDLL("libcuda.so.1")
assert cuda.cuInit(0) == 0, "cuInit failed"
n = ctypes.c_int(); assert cuda.cuDeviceGetCount(ctypes.byref(n)) == 0
print("CUDA driver API devices:", n.value)
buf = ctypes.create_string_buffer(256); cuda.cuDeviceGetName(buf, 256, 0)
print("Device 0:", buf.value.decode())
v = ctypes.c_int(); cuda.cuDriverGetVersion(ctypes.byref(v))
print("CUDA driver version:", v.value)
sys.exit(0 if n.value > 0 else 2)
PY

if [ "${CUDA_FULL:-0}" = "1" ]; then
  echo "== CUDA runtime check (nvcc deviceQuery) =="
  "${PODMAN[@]}" "${FULL_IMAGE}" bash -c '
cat > /tmp/q.cu <<EOF
#include <cstdio>
#include <cuda_runtime.h>
int main(){
  int n=0; cudaError_t e=cudaGetDeviceCount(&n);
  if(e){printf("CUDA error: %s\n", cudaGetErrorString(e)); return 1;}
  printf("CUDA devices: %d\n", n);
  for(int i=0;i<n;i++){cudaDeviceProp p; cudaGetDeviceProperties(&p,i);
    printf("  [%d] %s  cc %d.%d  %.1f GiB\n", i, p.name, p.major, p.minor,
           p.totalGlobalMem/1073741824.0);}
  return n>0?0:2;
}
EOF
nvcc -o /tmp/q /tmp/q.cu && /tmp/q'
fi
