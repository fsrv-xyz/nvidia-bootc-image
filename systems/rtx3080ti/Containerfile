# vLLM system image for the NVIDIA RTX 3080 Ti (12 GB).
# Builds on the generic base image and adds this system's own vLLM configuration:
# the logically bound vLLM image + the Quadlet service serving Qwen3.5-0.8B.
#
# BASE defaults to the published :main base; CI passes the matching per-pipeline tag,
# and local builds tag the freshly built base as this ref so FROM resolves offline.
ARG BASE=registry.fsrv.services/fsrvcorp/images/nvidia-bootc-image/base:main@sha256:17ccc5dffffa37e1805121b427570902651eb109ca6992bcd2b87e1ad6facf99
FROM ${BASE}

# This system's own vLLM files (vllm.image, vllm.container, tmpfiles, bound-images.d).
COPY files/ /

RUN bootc container lint
