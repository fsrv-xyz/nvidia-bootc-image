[Unit]
Description=vLLM OpenAI-compatible server (Qwen3.5-9B AWQ)
# GPU device nodes + CDI spec must exist; /var must be grown before the (large) pull.
After=nvidia-cdi-generate.service grow-var.service network-online.target
Wants=nvidia-cdi-generate.service grow-var.service network-online.target

[Container]
# Direct reference to the logically bound image. bootc pre-pulls it into its bound
# store (see /usr/lib/bootc/bound-images.d/vllm.image); podman finds it there via the
# additional-image-store config, so it runs from a single copy without re-pulling.
# Keep this tag in sync with vllm.image.
Image=docker.io/vllm/vllm-openai:v0.25.1@sha256:e4f88a835143cd22aee2397a26ec6bb80b3a4a6fe0c882bcbc63822904766089
# GPU via CDI (spec generated at boot by nvidia-cdi-generate.service).
AddDevice=nvidia.com/gpu=all
SecurityLabelDisable=true
# Host networking: the container uses the host resolver (systemd-resolved stub +
# NAT64) so HuggingFace resolves, and vLLM binds the host's port 8000 directly.
Network=host
# Persistent HF model cache on /var (downloaded on first start, survives reboots).
Volume=/var/lib/vllm/hf-cache:/root/.cache/huggingface:Z
Environment=HF_HOME=/root/.cache/huggingface
ShmSize=1g
# Entrypoint is `vllm serve`; the model is the positional argument.
# --host :: binds IPv6 (the host is IPv6-only).
# fp8 KV + max-model-len 80000 + explicit kv-cache-memory: the upstream GDN prefill-warmup
# leak (vLLM #36973) reserves ~1.6 GiB and also makes vLLM's memory profiler under-size the
# KV cache, leaving ~2 GiB of the GPU unused. Two levers together recover the full 80k:
#   * --kv-cache-dtype fp8 halves KV per token, and
#   * --kv-cache-memory 2600000000 (2.6 GiB) overrides the conservative profiler estimate
#     and explicitly claims the wasted VRAM.
# Measured on VM 110 (RTX 3080 Ti): 80000 context serves WITH CUDA graphs at ~107 tok/s
# single-stream and ~1.9x concurrency, leaving ~740 MiB headroom. Only trade-off is the
# fp8-quantized KV cache (minor quality). Beats --enforce-eager (80k @ ~27 tok/s) and
# --cpu-offload-gb (80k @ ~11 tok/s). Once #36973 is fixed upstream, the fp8 + explicit
# kv-cache-memory workaround can be dropped.
# Full background/options/measurements: see systems/rtx3080ti/README.md.
Exec=cyankiwi/Qwen3.5-9B-AWQ-4bit --served-model-name qwen3.5-9b --host :: --port 8000 --max-model-len 80000 --gpu-memory-utilization 0.95 --max-num-seqs 4 --max-num-batched-tokens 2048 --reasoning-parser qwen3 --enable-auto-tool-choice --tool-call-parser qwen3_coder --limit-mm-per-prompt '{"image":0,"video":0}' --kv-cache-dtype fp8 --kv-cache-memory 2600000000

[Service]
Restart=on-failure
RestartSec=10
# First start downloads the model weights.
TimeoutStartSec=3600

[Install]
WantedBy=multi-user.target
