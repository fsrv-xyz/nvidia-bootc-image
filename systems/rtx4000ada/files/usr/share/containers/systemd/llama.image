# Logically bound image: the /usr/lib/bootc/bound-images.d/llama.image symlink points
# bootc at this file; bootc pulls the image into its bound store on install/upgrade and
# binds it to the OS deployment. No [Install] here on purpose — the container references
# the image directly and reads it from the bootc store (additional image store). Keep
# this tag in sync with llama.container.
[Image]
Image=ghcr.io/ggml-org/llama.cpp:server-cuda@sha256:82de60bb2ba6e66d750f4b7db8752bc3071a2ed3999700d0b21c8b5c709b5513
